<%- include('partials/header') %>

    <main class="contact-main">
        <div class="contact-header">
            <h1>Contacto</h1>
            <p class="text-light">¿Tienes alguna duda o sugerencia? Escríbenos y te responderemos lo antes posible.</p>
        </div>

        <div class="contact-grid">
            <div class="contact-form-container">
                <% if (success) { %>
                    <p class="form-success"><%= success %></p>
                <% } %>
                <% if (error) { %>
                    <p class="form-error"><%= error %></p>
                <% } %>

                <form method="post" action="/contacto">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="name">Nombre</label>
                            <input type="text" id="name" name="name" value="<%= values.name || '' %>" placeholder="Tu nombre" autocomplete="name" required>
                        </div>
                        <div class="form-group">
                            <label for="email">Correo electrónico</label>
                            <input type="email" id="email" name="email" value="<%= values.email || '' %>" placeholder="correo@ejemplo.com" autocomplete="email" required>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="subject">Asunto</label>
                        <input type="text" id="subject" name="subject" value="<%= values.subject || '' %>" placeholder="Asunto del mensaje" required>
                    </div>

                    <div class="form-group">
                        <label for="message">Mensaje</label>
                        <textarea id="message" name="message" placeholder="Escribe tu mensaje..." required><%= values.message || '' %></textarea>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">Enviar mensaje</button>
                        <button type="reset" class="btn btn-outline">Limpiar</button>
                    </div>
                </form>
            </div>

            <aside class="contact-sidebar">
                <div class="contact-info-card">
                    <h3>Otras vías de contacto</h3>

                    <div class="contact-info-list">
                        <div class="contact-info-item">
                            <div class="contact-icon icon-mail"></div>
                            <div>
                                <h4>Correo</h4>
                                <p>proyectic@ejemplo.com</p>
                            </div>
                        </div>

                        <div class="contact-info-item">
                            <div class="contact-icon icon-time"></div>
                            <div>
                                <h4>Horario de respuesta</h4>
                                <p>Lunes a viernes · 24-48 h</p>
                            </div>
                        </div>
                    </div>

                    <div class="map-placeholder">
                        <span>🗺️ mapa / ubicación (opcional)</span>
                    </div>
                </div>
            </aside>
        </div>
    </main>

<%- include('partials/footer') %>
