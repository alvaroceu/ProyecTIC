<%- include('partials/header') %>

    <main class="board-view-main">

        <div class="board-view-header">
            <div class="breadcrumbs">
                <a href="/boards">Mis tableros</a> <span class="separator">›</span> <span><%= board.name %></span>
            </div>

            <div class="board-header-content">
                <div class="board-title-group">
                    <h1><%= board.name %></h1>
                </div>

                <% if (role === 'admin') { %>
                    <div class="board-admin-actions">
                        <a href="/boards/<%= board.id %>/members" class="btn btn-dashed">Invitar</a>
                        <a href="/boards/<%= board.id %>/settings" class="btn btn-dashed">Ajustes</a>
                    </div>
                <% } %>
            </div>
        </div>

        <div class="kanban-container">
            <% board.BoardColumns.forEach((column) => { %>
                <div class="kanban-column">
                    <div class="kanban-column-header">
                        <h3 class="kanban-column-title"><%= column.name %></h3>
                        <span class="kanban-column-count"><%= column.Cards.length %></span>
                    </div>

                    <div class="kanban-cards-list">
                        <% column.Cards.forEach((card) => { %>
                            <div class="kanban-card">
                                <div class="kanban-card-content">
                                    <h4 class="kanban-card-title"><%= card.title %></h4>
                                </div>
                                <% if (card.dueDate) { %>
                                    <div class="kanban-card-footer">
                                        <div class="kanban-card-meta">
                                            <span class="badge-date"><%= card.dueDate %></span>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                        <% }) %>
                    </div>

                    <% if (role !== 'guest') { %>
                        <a href="/boards/<%= board.id %>/cards/new?column=<%= column.id %>" class="add-card-btn">+ Añadir tarjeta</a>
                    <% } %>
                </div>
            <% }) %>
        </div>

    </main>

<%- include('partials/footer') %>