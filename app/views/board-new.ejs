<%- include('partials/header') %>

    <main class="create-board-main">

        <div class="create-board-header">
            <div class="breadcrumbs">
                <a href="/boards">Mis tableros</a> <span class="separator">›</span> <span>Crear tablero</span>
            </div>
            <h1>Crear tablero</h1>
        </div>

        <div class="create-board-grid">

            <div class="form-card">
                <% if (error) { %>
                    <p class="form-error"><%= error %></p>
                <% } %>

                <form action="/boards" method="post">

                    <div class="form-group">
                        <label for="board-name">Nombre del tablero *</label>
                        <input type="text" id="board-name" name="name"
                               value="<%= values.name || '' %>"
                               placeholder="Ej.: Trabajo de Sistemas Web" required>
                    </div>

                    <div class="form-group">
                        <label for="board-desc">Descripción</label>
                        <textarea id="board-desc" name="description"
                                  placeholder="Describe brevemente el proyecto..."><%= values.description || '' %></textarea>
                    </div>

                    <div class="form-actions-inline">
                        <a href="/boards" class="btn btn-outline">Cancelar</a>
                        <button type="submit" class="btn btn-primary">Crear tablero</button>
                    </div>

                </form>
            </div>

            <aside class="create-board-sidebar">
                <div class="info-card-dashed">
                    <h3>Columnas por defecto</h3>
                    <p>1. Pendiente &nbsp;&nbsp; 2. En Proceso &nbsp;&nbsp; 3. Terminado</p>
                </div>
                <p class="role-note text-blue">El creador pasa a ser Administrador del tablero</p>
            </aside>

        </div>
    </main>

<%- include('partials/footer') %>